{
  "name": "fashion-aggregator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"npm run dev -w @fashion-aggregator/web\" \"npm run dev -w @fashion-aggregator/api\"",
    "dev:web": "npm run dev -w @fashion-aggregator/web",
    "dev:api": "npm run dev -w @fashion-aggregator/api",
    "build:packages": "npm run build -w @fashion-aggregator/domain && npm run build -w @fashion-aggregator/contracts",
    "build": "npm run build:packages && npm run build -w @fashion-aggregator/api && npm run build -w @fashion-aggregator/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test packages/*/tests/**/*.test.ts apps/*/tests/**/*.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
